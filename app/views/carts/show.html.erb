<% content_for :title, "Panier - VELOCITY" %>

<section class="pt-32 pb-20 bg-white min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="font-display text-5xl font-bold mb-12">MON PANIER</h2>

    <% if @items.empty? %>
      <div class="text-center py-24">
        <p class="text-gray-400 text-lg mb-6">Ton panier est vide.</p>
        <%= link_to "Voir tous les produits", products_path, class: "magnetic-btn bg-black text-white px-8 py-4 rounded-full font-semibold hover:bg-red-600 transition-colors inline-block" %>
      </div>
    <% else %>
      <div class="space-y-6 mb-10">
        <% @items.each do |item| %>
          <div class="flex items-center gap-6 border border-gray-100 rounded-2xl p-4">
            <div class="w-24 h-24 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0">
              <%= image_tag item[:product].image_url, alt: item[:product].name, class: "w-full h-full object-cover" %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-gray-400 uppercase tracking-wide"><%= item[:product].category.name %></p>
              <h4 class="font-bold text-lg truncate"><%= item[:product].name %></h4>
              <p class="font-display text-xl font-bold text-red-600"><%= item[:product].formatted_price %></p>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <span class="text-sm text-gray-500">Qté : <strong><%= item[:quantity] %></strong></span>
              <%= button_to remove_from_cart_path(item[:product].id), method: :delete,
                    class: "text-gray-400 hover:text-red-600 transition-colors p-2" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="border-t border-gray-200 pt-8 flex flex-col sm:flex-row justify-between items-center gap-6">
        <div>
          <p class="text-gray-500 text-sm">Total</p>
          <p class="font-display text-4xl font-bold"><%= number_to_currency(@total, unit: "€", format: "%n %u", separator: ",", delimiter: " ") %></p>
        </div>
        <%= button_to "Commander →", checkout_path, method: :post,
              class: "magnetic-btn bg-black text-white px-10 py-4 rounded-full font-bold text-lg hover:bg-red-600 transition-colors" %>
      </div>
    <% end %>
  </div>
</section>
