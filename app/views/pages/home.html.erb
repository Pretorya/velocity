<% content_for :title, "VELOCITY - Chaussures de Performance" %>

<!-- Hero Section -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100 pt-20">
  <!-- Cercles décoratifs animés -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-red-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-float"></div>
  <div class="absolute top-40 right-10 w-72 h-72 bg-yellow-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-float" style="animation-delay: 2s;"></div>
  <div class="absolute -bottom-8 left-1/2 w-72 h-72 bg-pink-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-float" style="animation-delay: 4s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid md:grid-cols-2 gap-12 items-center">
    <!-- Texte -->
    <div class="space-y-6 animate-slide-in">
      <p class="text-red-600 font-semibold tracking-widest text-sm uppercase">Nouvelle Collection 2024</p>
      <h2 class="font-display text-6xl md:text-8xl font-bold leading-none tracking-tighter glitch-text" data-text="AIR">
        AIR <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-orange-500">VELOCITY</span>
      </h2>
      <p class="text-gray-600 text-lg max-w-md leading-relaxed">
        Repoussez vos limites avec notre nouvelle technologie d'amorti révolutionnaire. Légèreté extrême, réactivité maximale.
      </p>
      <div class="flex gap-4 pt-4">
        <button class="magnetic-btn bg-black text-white px-8 py-4 rounded-full font-semibold hover:bg-red-600 transition-colors flex items-center gap-2">
          Découvrir
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </button>
        <button class="magnetic-btn border-2 border-black px-8 py-4 rounded-full font-semibold hover:bg-black hover:text-white transition-all">
          Voir la vidéo
        </button>
      </div>

      <!-- Stats -->
      <div class="flex gap-8 pt-8 border-t border-gray-200">
        <% [["50%", "Plus légère"], ["100%", "Recyclable"], ["4.9", "Note moyenne"]].each do |value, label| %>
          <div>
            <p class="font-display text-3xl font-bold"><%= value %></p>
            <p class="text-sm text-gray-500"><%= label %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Image Hero -->
    <div class="relative animate-slide-in delay-200">
      <div class="relative z-10 animate-float">
        <%= image_tag "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800&q=80",
            alt: "Air Velocity",
            class: "w-full h-auto drop-shadow-2xl transform hover:rotate-3 transition-transform duration-500" %>
      </div>
      <div class="absolute top-10 -right-4 bg-white p-4 rounded-2xl shadow-xl animate-slide-in delay-300">
        <p class="font-bold text-sm">Nouveau</p>
        <p class="text-xs text-gray-500">Coloris limité</p>
      </div>
      <div class="absolute bottom-20 -left-4 bg-black text-white p-4 rounded-2xl shadow-xl animate-slide-in delay-300">
        <p class="font-bold text-sm">189 €</p>
        <p class="text-xs text-gray-400">Au lieu de 220 €</p>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<!-- Catégories -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h3 class="font-display text-4xl font-bold mb-12 text-center">SHOP PAR CATÉGORIE</h3>

    <div class="grid md:grid-cols-3 gap-6">
      <% @categories.each do |category| %>
        <%= link_to category_path(category), class: "group relative overflow-hidden rounded-3xl h-96 cursor-pointer block" do %>
          <%= image_tag category.image_url,
              alt: category.name,
              class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-8">
            <div>
              <h4 class="text-white font-display text-3xl font-bold mb-2"><%= category.name.upcase %></h4>
              <p class="text-gray-200 text-sm mb-4 opacity-0 group-hover:opacity-100 transition-opacity"><%= category.subtitle %></p>
              <span class="text-white border border-white px-6 py-2 rounded-full text-sm hover:bg-white hover:text-black transition-all">
                Explorer
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- Produits phares -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h3 class="font-display text-4xl font-bold mb-2">TENDANCES DU MOMENT</h3>
        <p class="text-gray-600">Les modèles les plus populaires cette semaine</p>
      </div>
      <%= link_to "Voir tout →", products_path, class: "text-red-600 font-semibold hover:underline hidden md:block" %>
    </div>

    <div class="dynamic-grid">
      <% @products.each do |product| %>
        <%= link_to product_path(product), class: "shoe-card bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl group" do %>
          <div class="relative mb-4 overflow-hidden rounded-xl bg-gray-100 aspect-square">
            <%= image_tag product.image_url,
                alt: product.name,
                class: "shoe-image w-full h-full object-cover transition-transform duration-500" %>
            <% if product.badge.present? %>
              <span class="absolute top-4 left-4 <%= product.badge_color %> text-white text-xs px-3 py-1 rounded-full">
                <%= product.badge %>
              </span>
            <% end %>
          </div>
          <div class="space-y-2">
            <p class="text-xs text-gray-500 uppercase tracking-wide"><%= product.category.name %></p>
            <h4 class="font-bold text-lg"><%= product.name %></h4>
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-2">
                <p class="font-display text-xl font-bold"><%= product.formatted_price %></p>
                <% if product.old_price? %>
                  <p class="text-sm text-gray-400 line-through"><%= product.formatted_old_price %></p>
                <% end %>
              </div>
              <div class="flex gap-1">
                <% product.color_classes.each do |color| %>
                  <div class="w-4 h-4 rounded-full <%= color %> border-2 border-white shadow-sm"></div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- Section Membre -->
<section class="py-20 bg-black text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-20">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h3 class="font-display text-5xl font-bold mb-6">
          REJOINS LA <span class="text-red-600">VELOCITY</span> FAMILLE
        </h3>
        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
          Inscris-toi maintenant et obtiens 15% de réduction sur ta première commande. Accès exclusif aux nouvelles collections, événements sportifs et conseils personnalisés.
        </p>
        <div class="flex gap-4 flex-col sm:flex-row">
          <input type="email" placeholder="Ton email"
                 class="px-6 py-4 rounded-full bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-red-600 flex-1">
          <button class="magnetic-btn bg-red-600 px-8 py-4 rounded-full font-bold hover:bg-red-700 transition-colors whitespace-nowrap">
            S'inscrire
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-4">En t'inscrivant, tu acceptes notre politique de confidentialité.</p>
      </div>
      <div class="relative">
        <%= image_tag "https://images.unsplash.com/photo-1511556532299-8f662fc26c06?w=600&q=80",
            alt: "Community",
            class: "rounded-3xl shadow-2xl transform rotate-3 hover:rotate-0 transition-transform duration-500" %>
        <div class="absolute -bottom-6 -left-6 bg-white text-black p-6 rounded-2xl shadow-xl">
          <p class="font-display text-3xl font-bold">50K+</p>
          <p class="text-sm text-gray-600">Membres actifs</p>
        </div>
      </div>
    </div>
  </div>
</section>
