<% content_for :title, "Contact - VELOCITY" %>

<section class="pt-32 pb-20 bg-white min-h-screen">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-12">
      <h2 class="font-display text-5xl font-bold mb-3">CONTACT</h2>
      <p class="text-gray-500">Une question ? On te répond sous 48h.</p>
    </div>

    <% if notice %>
      <div class="mb-8 bg-green-50 border border-green-200 text-green-800 rounded-2xl px-6 py-4 text-sm">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="mb-8 bg-red-50 border border-red-200 text-red-700 rounded-2xl px-6 py-4 text-sm">
        <%= alert %>
      </div>
    <% end %>

    <%= form_with url: "/contact", method: :post, class: "space-y-6" do |f| %>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Nom</label>
          <%= f.text_field :name, placeholder: "Ton nom",
                class: "w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-black transition-colors",
                value: params[:name] %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
          <%= f.email_field :email, placeholder: "ton@email.com",
                class: "w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-black transition-colors",
                value: params[:email] %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Sujet</label>
        <%= f.select :subject,
              [["Commande / livraison", "commande"], ["Retour / remboursement", "retour"], ["Produit", "produit"], ["Autre", "autre"]],
              {},
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-black transition-colors bg-white" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Message</label>
        <%= f.text_area :message, placeholder: "Décris ta demande...", rows: 6,
              class: "w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-black transition-colors resize-none" %></div>

      <%= f.submit "Envoyer le message",
            class: "magnetic-btn w-full bg-black text-white py-4 rounded-full font-bold text-base hover:bg-red-600 transition-colors cursor-pointer" %>
    <% end %>

  </div>
</section>
