<% content_for :title, "Commande confirmée - VELOCITY" %>

<section class="pt-32 pb-20 bg-white min-h-screen flex items-center justify-center">
  <div class="max-w-lg mx-auto px-4 text-center">
    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-8">
      <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <h2 class="font-display text-5xl font-bold mb-4">MERCI !</h2>
    <p class="text-gray-500 text-lg mb-10">
      Ta commande a bien été confirmée. Tu recevras une confirmation par email.
    </p>
    <%= link_to "Continuer mes achats", products_path,
          class: "magnetic-btn bg-black text-white px-10 py-4 rounded-full font-bold hover:bg-red-600 transition-colors inline-block" %>
  </div>
</section>
