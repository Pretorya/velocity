<% content_for :title, "#{@product.name} - VELOCITY" %>

<section class="pt-32 pb-20 bg-white min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <p class="text-sm text-gray-400 mb-8">
      <%= link_to "Accueil", root_path, class: "hover:text-red-600" %> /
      <%= link_to @product.category.name, category_path(@product.category), class: "hover:text-red-600" %> /
      <%= @product.name %>
    </p>

    <div class="grid md:grid-cols-2 gap-16 items-start">
      <!-- Image -->
      <div class="relative rounded-3xl overflow-hidden bg-gray-100 aspect-square">
        <%= image_tag @product.image_url, alt: @product.name, class: "w-full h-full object-cover" %>
        <% if @product.badge.present? %>
          <span class="absolute top-6 left-6 <%= @product.badge_color %> text-white text-sm px-4 py-2 rounded-full">
            <%= @product.badge %>
          </span>
        <% end %>
      </div>

      <!-- Infos -->
      <div class="space-y-6">
        <p class="text-sm text-gray-400 uppercase tracking-widest"><%= @product.category.name %></p>
        <h1 class="font-display text-5xl font-bold"><%= @product.name %></h1>

        <div class="flex items-center gap-4">
          <p class="font-display text-4xl font-bold"><%= @product.formatted_price %></p>
          <% if @product.old_price? %>
            <p class="text-xl text-gray-400 line-through"><%= @product.formatted_old_price %></p>
          <% end %>
        </div>

        <% if @product.color_classes.any? %>
          <div>
            <p class="text-sm font-medium mb-3">Coloris disponibles</p>
            <div class="flex gap-2">
              <% @product.color_classes.each do |color| %>
                <div class="w-8 h-8 rounded-full <%= color %> border-2 border-white shadow ring-2 ring-gray-200"></div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= button_to add_to_cart_path(@product.id),
              method: :post,
              class: "magnetic-btn w-full bg-black text-white py-4 rounded-full font-bold text-lg hover:bg-red-600 transition-colors" do %>
          Ajouter au panier
        <% end %>

        <%= link_to "← Retour", :back, class: "text-sm text-gray-400 hover:text-black" %>
      </div>
    </div>
  </div>
</section>
