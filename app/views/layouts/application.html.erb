<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title) || "VELOCITY - Chaussures de Performance" %></title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: 'Inter', sans-serif; overflow-x: hidden; }
      .font-display { font-family: 'Oswald', sans-serif; }

      @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(2deg); }
      }
      @keyframes slideIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-float { animation: float 6s ease-in-out infinite; }
      .animate-slide-in { animation: slideIn 0.8s ease-out forwards; }
      .delay-100 { animation-delay: 0.1s; }
      .delay-200 { animation-delay: 0.2s; }
      .delay-300 { animation-delay: 0.3s; }

      .glitch-text { position: relative; display: inline-block; }
      .glitch-text::before, .glitch-text::after {
        content: attr(data-text);
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      }
      .glitch-text::before {
        left: 2px; text-shadow: -2px 0 #ff00c1;
        clip: rect(44px, 450px, 56px, 0);
        animation: glitch-anim 5s infinite linear alternate-reverse;
      }
      .glitch-text::after {
        left: -2px; text-shadow: -2px 0 #00fff9;
        clip: rect(44px, 450px, 56px, 0);
        animation: glitch-anim2 5s infinite linear alternate-reverse;
      }
      @keyframes glitch-anim {
        0%   { clip: rect(12px, 9999px, 52px, 0); }
        20%  { clip: rect(65px, 9999px, 11px, 0); }
        40%  { clip: rect(26px, 9999px, 89px, 0); }
        60%  { clip: rect(78px, 9999px, 14px, 0); }
        80%  { clip: rect(33px, 9999px, 66px, 0); }
        100% { clip: rect(55px, 9999px, 99px, 0); }
      }
      @keyframes glitch-anim2 {
        0%   { clip: rect(65px, 9999px, 99px, 0); }
        20%  { clip: rect(12px, 9999px, 52px, 0); }
        40%  { clip: rect(78px, 9999px, 14px, 0); }
        60%  { clip: rect(26px, 9999px, 89px, 0); }
        80%  { clip: rect(55px, 9999px, 99px, 0); }
        100% { clip: rect(33px, 9999px, 66px, 0); }
      }

      .shoe-card { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
      .shoe-card:hover { transform: translateY(-10px) scale(1.02); }
      .shoe-card:hover .shoe-image { transform: rotate(-5deg) scale(1.1); }

      .nav-blur { backdrop-filter: blur(20px); background: rgba(255, 255, 255, 0.85); }

      .marquee { display: flex; animation: marquee 20s linear infinite; }
      @keyframes marquee {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      .magnetic-btn { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
      .magnetic-btn:hover { transform: scale(1.05); }

      .dynamic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
      }
      @media (max-width: 768px) {
        .dynamic-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>

  <body class="bg-white text-black">

    <!-- Bandeau d'annonce -->
    <div class="bg-black text-white text-xs py-2 overflow-hidden">
      <div class="marquee whitespace-nowrap">
        <span class="mx-8">LIVRAISON GRATUITE DÈS 100€</span>
        <span class="mx-8">•</span>
        <span class="mx-8">NOUVELLE COLLECTION 2024 DISPONIBLE</span>
        <span class="mx-8">•</span>
        <span class="mx-8">RETOURS GRATUITS SOUS 30 JOURS</span>
        <span class="mx-8">•</span>
        <span class="mx-8">LIVRAISON GRATUITE DÈS 100€</span>
        <span class="mx-8">•</span>
        <span class="mx-8">NOUVELLE COLLECTION 2024 DISPONIBLE</span>
        <span class="mx-8">•</span>
        <span class="mx-8">RETOURS GRATUITS SOUS 30 JOURS</span>
        <span class="mx-8">•</span>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="nav-blur fixed w-full z-50 border-b border-gray-100 transition-all duration-300" id="navbar">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          <!-- Logo -->
          <div class="flex-shrink-0 cursor-pointer group">
            <%= link_to root_path, class: "group" do %>
              <h1 class="font-display text-3xl font-bold tracking-tighter group-hover:text-red-600 transition-colors">
                VELOCITY
              </h1>
            <% end %>
          </div>

          <!-- Menu Desktop -->
          <div class="hidden md:flex space-x-8 items-center">
            <%= link_to "NOUVEAUTÉS", products_path, class: "text-sm font-medium hover:text-red-600 transition-colors relative group" %>
            <% Category.all.each do |cat| %>
              <%= link_to cat.name.upcase, category_path(cat), class: "text-sm font-medium hover:text-red-600 transition-colors relative group" %>
            <% end %>
          </div>

          <!-- Icônes -->
          <div class="flex items-center space-x-6">
            <!-- Search -->
            <div class="relative flex items-center" id="search-container">
              <form action="<%= products_path %>" method="get" id="search-form" class="hidden absolute right-8 top-1/2 -translate-y-1/2 w-64">
                <input type="text" name="q" value="<%= params[:q] %>" placeholder="Rechercher un produit..."
                       autofocus
                       class="w-full pl-4 pr-10 py-2 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-red-600 bg-white shadow">
              </form>
              <button type="button" onclick="toggleSearch()" class="hover:text-red-600 transition-colors relative z-10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </button>
            </div>
            <%= link_to cart_path, class: "hover:text-red-600 transition-colors relative" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              <% if cart_count > 0 %>
                <span class="absolute -top-2 -right-2 bg-red-600 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center">
                  <%= cart_count %>
                </span>
              <% end %>
            <% end %>
            <button class="hover:text-red-600 transition-colors md:hidden">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Contenu principal -->
    <%= yield %>

    <!-- Footer -->
    <footer class="bg-gray-100 pt-20 pb-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-4 gap-12 mb-16">
          <div>
            <h4 class="font-display text-2xl font-bold mb-6">VELOCITY</h4>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              Marque de chaussures de performance fondée en 2020. Notre mission : créer des produits innovants pour les athlètes du monde entier.
            </p>
            <div class="flex gap-4">
              <a href="#" class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:bg-red-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                </svg>
              </a>
              <a href="#" class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:bg-red-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            </div>
          </div>

          <div>
            <h5 class="font-bold mb-4">SHOP</h5>
            <ul class="space-y-3 text-sm text-gray-600">
              <li><%= link_to "Nouveautés", products_path, class: "hover:text-red-600 transition-colors" %></li>
              <% Category.all.each do |cat| %>
                <li><%= link_to cat.name, category_path(cat), class: "hover:text-red-600 transition-colors" %></li>
              <% end %>
            </ul>
          </div>

          <div>
            <h5 class="font-bold mb-4">AIDE</h5>
            <ul class="space-y-3 text-sm text-gray-600">
              <li><%= link_to "Contact", contact_path, class: "hover:text-red-600 transition-colors" %></li>
              <li><%= link_to "FAQ",     faq_path,     class: "hover:text-red-600 transition-colors" %></li>
            </ul>
          </div>

          <div>
            <h5 class="font-bold mb-4">ENTREPRISE</h5>
            <ul class="space-y-3 text-sm text-gray-600">
              <li><%= link_to "À propos",  about_path,    class: "hover:text-red-600 transition-colors" %></li>
              <li><%= link_to "Carrières", careers_path,  class: "hover:text-red-600 transition-colors" %></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-gray-300 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-sm text-gray-500">© <%= Date.current.year %> Velocity. Tous droits réservés.</p>
          <div class="flex gap-6 text-sm text-gray-500">
            <a href="#" class="hover:text-black">Confidentialité</a>
            <a href="#" class="hover:text-black">Conditions</a>
            <a href="#" class="hover:text-black">Cookies</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Navigation scroll effect
      window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (window.scrollY > 50) {
          navbar.classList.add('shadow-md');
        } else {
          navbar.classList.remove('shadow-md');
        }
      });

      // Animation au scroll
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-slide-in');
            entry.target.style.opacity = '1';
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

      function toggleSearch() {
        const form = document.getElementById('search-form');
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) {
          form.querySelector('input').focus();
        }
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.getElementById('search-form').classList.add('hidden');
        }
      });

      document.querySelectorAll('.shoe-card, .group').forEach((el) => {
        el.style.opacity = '0';
        observer.observe(el);
      });
    </script>
  </body>
</html>
